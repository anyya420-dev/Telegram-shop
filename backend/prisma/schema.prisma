generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  telegramId     String   @unique @map("telegram_id")
  username       String?
  firstName      String   @map("first_name")
  lastName       String?  @map("last_name")
  selectedCityId Int?     @map("selected_city_id")
  language       String   @default("ru")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  selectedCity     City? @relation("SelectedCity", fields: [selectedCityId], references: [id])
  cart             Cart?
  orders           Order[]
  balance          Balance?
  casinoBalance    CasinoBalance?
  casinoRewards    CasinoReward[]
  reviews          Review[]
  wishlists        Wishlist[]
  supportTickets   SupportTicket[]
  activityLogs     UserActivityLog[]

  @@map("users")
}

model City {
  id         Int           @id @default(autoincrement())
  name       String        @unique
  nameEn     String?       @map("name_en")
  isActive   Boolean       @default(true) @map("is_active")
  sortOrder  Int           @default(0) @map("sort_order")
  createdAt  DateTime      @default(now()) @map("created_at")

  users         User[]        @relation("SelectedCity")
  productCities ProductCity[]
  orders        Order[]

  @@map("cities")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  nameEn    String?   @map("name_en")
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id            Int           @id @default(autoincrement())
  name          String
  nameEn        String?       @map("name_en")
  description   String
  descriptionEn String?       @map("description_en")
  price         Float
  image         String?
  categoryId    Int           @map("category_id")
  creditsEnabled Boolean      @default(false) @map("credits_enabled")
  creditsPrice   Float?       @map("credits_price")
  minCreditsRequired Float?   @map("min_credits_required")
  isActive      Boolean       @default(true) @map("is_active")
  isRecommended Boolean       @default(false) @map("is_recommended")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  category      Category      @relation(fields: [categoryId], references: [id])
  productCities ProductCity[]
  reviews       Review[]

  @@map("products")
}

model ProductCity {
  id              Int        @id @default(autoincrement())
  productId       Int        @map("product_id")
  cityId          Int        @map("city_id")
  stock           Float      @default(0)
  minimumQuantity Float      @default(1) @map("minimum_quantity")
  quantityStep    Float      @default(1) @map("quantity_step")
  maximumQuantity Float      @default(100) @map("maximum_quantity")
  unit            String     @default("шт.")
  isAvailable     Boolean    @default(true) @map("is_available")

  product   Product    @relation(fields: [productId], references: [id])
  city      City       @relation(fields: [cityId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlists  Wishlist[]

  @@unique([productId, cityId])
  @@map("product_cities")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model Order {
  id               Int         @id @default(autoincrement())
  userId           Int         @map("user_id")
  cityId           Int         @map("city_id")
  status           String      @default("pending")
  paymentStatus    String?     @map("payment_status") // unpaid | pending | confirmed | rejected
  subtotal         Float
  discountAmount   Float       @default(0) @map("discount_amount")
  deliveryFee      Float       @default(0) @map("delivery_fee")
  total            Float
  comment          String?
  paymentMethodId  Int?        @map("payment_method_id")
  deliveryOptionId Int?        @map("delivery_option_id")
  discountId       Int?        @map("discount_id")
  operatorId              Int?     @map("operator_id")
  operatorDeliveryPrice   Float?   @map("operator_delivery_price")
  deliveryPriceConfirmed  Boolean  @default(false) @map("delivery_price_confirmed")
  casinoCreditsUsed Float      @default(0) @map("casino_credits_used")
  cancelledAt      DateTime?   @map("cancelled_at")
  refundStatus     String?     @map("refund_status") // none | requested | approved | rejected
  refundAt         DateTime?   @map("refund_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id])
  city           City                 @relation(fields: [cityId], references: [id])
  items          OrderItem[]
  paymentMethod  PaymentMethod?       @relation(fields: [paymentMethodId], references: [id])
  deliveryOption DeliveryOption?      @relation(fields: [deliveryOptionId], references: [id])
  discount       Discount?            @relation(fields: [discountId], references: [id])
  operator       Operator?            @relation(fields: [operatorId], references: [id])
  reward         CasinoReward?        @relation("OrderReward")
  statusHistory  OrderStatusHistory[]
  payments       Payment[]

  @@map("orders")
}

model PaymentMethod {
  id                  Int       @id @default(autoincrement())
  type                String    // card | crypto
  title               String
  cardNumber          String?   @map("card_number")
  cardholderName      String?   @map("cardholder_name")
  currency            String?
  provider            String?
  providerMode        String?   @map("provider_mode")
  providerKey         String?   @map("provider_key")
  providerConfig      String?   @map("provider_config")
  asset               String?
  network             String?
  walletAddress       String?   @map("wallet_address")
  displayName         String?   @map("display_name")
  instructions        String?
  sortOrder           Int       @default(0) @map("sort_order")
  isTonConnectEnabled Boolean   @default(false) @map("is_ton_connect_enabled")
  isEnabled           Boolean   @default(true) @map("is_enabled")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  orders   Order[]
  payments Payment[]

  @@map("payment_methods")
}

model Payment {
  id                Int       @id @default(autoincrement())
  orderId           Int       @map("order_id")
  paymentMethodId   Int       @map("payment_method_id")
  status            String    @default("pending")
  amount            Float
  currency          String?
  asset             String?
  network           String?
  provider          String?
  providerPaymentId String?   @unique @map("provider_payment_id")
  providerSessionId String?   @unique @map("provider_session_id")
  checkoutUrl       String?   @map("checkout_url")
  recipient         String?
  senderAddress     String?   @map("sender_address")
  transactionHash   String?   @unique @map("transaction_hash")
  referenceCode     String?   @unique @map("reference_code")
  metadata          String?
  failureReason     String?   @map("failure_reason")
  paidAt            DateTime? @map("paid_at")
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([orderId, createdAt])
  @@index([status, expiresAt])
  @@map("payments")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int     @map("order_id")
  productCityId Int     @map("product_city_id")
  productName   String  @map("product_name")
  productImage  String? @map("product_image")
  unit          String
  quantity      Float
  price         Float
  lineTotal     Float   @map("line_total")

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productCity ProductCity @relation(fields: [productCityId], references: [id])

  @@map("order_items")
}

model CartItem {
  id            Int         @id @default(autoincrement())
  cartId        Int         @map("cart_id")
  productCityId Int         @map("product_city_id")
  quantity      Float

  cart        Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productCity ProductCity @relation(fields: [productCityId], references: [id])

  @@unique([cartId, productCityId])
  @@map("cart_items")
}

model Balance {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  amount    Float    @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id])
  transactions BalanceTransaction[]

  @@map("balances")
}

model CasinoBalance {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  credits   Float    @default(1000)
  lifetimeWon Float  @default(0) @map("lifetime_won")
  lifetimeSpent Float @default(0) @map("lifetime_spent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                     @relation(fields: [userId], references: [id])
  rounds       CasinoRound[]
  transactions CasinoCreditTransaction[]

  @@map("casino_balances")
}

model CasinoRound {
  id              Int      @id @default(autoincrement())
  casinoBalanceId Int      @map("casino_balance_id")
  game            String   @default("wheel")
  requestId       String   @unique @map("request_id")
  status          String   @default("completed")
  betAmount       Float    @map("bet_amount")
  targetValue     String?  @map("target_value")
  outcomeValue    String?  @map("outcome_value")
  payoutAmount    Float    @default(0) @map("payout_amount")
  netChange       Float    @map("net_change")
  isWin           Boolean  @map("is_win")
  rewardConfigId  Int?     @map("reward_config_id")
  rewardId        Int?     @unique @map("reward_id")
  metadata        String?
  createdAt       DateTime @default(now()) @map("created_at")

  casinoBalance CasinoBalance     @relation(fields: [casinoBalanceId], references: [id], onDelete: Cascade)
  rewardConfig  CasinoRewardConfig? @relation(fields: [rewardConfigId], references: [id])
  reward        CasinoReward?     @relation(fields: [rewardId], references: [id])

  @@index([casinoBalanceId, createdAt])
  @@map("casino_rounds")
}

model CasinoGameConfig {
  id        Int      @id @default(autoincrement())
  game      String   @unique
  isEnabled Boolean  @default(true) @map("is_enabled")
  minBet    Float    @default(10) @map("min_bet")
  maxBet    Float    @default(500) @map("max_bet")
  spinLimit Int      @default(1) @map("spin_limit")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rewardConfigs CasinoRewardConfig[]

  @@map("casino_game_configs")
}

model CasinoRewardConfig {
  id              Int      @id @default(autoincrement())
  game            String
  rewardType      String   @map("reward_type")
  title           String
  resultKey       String?  @map("result_key")
  discountPercent Float?   @map("discount_percent")
  creditAmount    Float?   @map("credit_amount")
  weight          Int      @default(1)
  isActive        Boolean  @default(true) @map("is_active")
  expiresInHours  Int?     @map("expires_in_hours")
  minOrderAmount  Float?   @map("min_order_amount")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  gameConfig CasinoGameConfig @relation(fields: [game], references: [game], onDelete: Cascade)
  rounds     CasinoRound[]

  @@index([game, isActive])
  @@map("casino_reward_configs")
}

model CasinoReward {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  game            String
  rewardType      String   @map("reward_type")
  status          String   @default("available")
  discountPercent Float?   @map("discount_percent")
  creditAmount    Float?   @map("credit_amount")
  minOrderAmount  Float?   @map("min_order_amount")
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime? @map("expires_at")
  usedAt          DateTime? @map("used_at")
  orderId         Int?     @unique @map("order_id")

  user  User       @relation(fields: [userId], references: [id])
  order Order?        @relation("OrderReward", fields: [orderId], references: [id])
  round CasinoRound?

  @@index([userId, status, expiresAt])
  @@map("casino_rewards")
}

model CasinoCreditTransaction {
  id              Int      @id @default(autoincrement())
  casinoBalanceId Int      @map("casino_balance_id")
  amount          Float
  type            String
  reason          String?
  orderId         Int?     @map("order_id")
  roundId         Int?     @map("round_id")
  createdAt       DateTime @default(now()) @map("created_at")

  casinoBalance CasinoBalance @relation(fields: [casinoBalanceId], references: [id], onDelete: Cascade)

  @@index([casinoBalanceId, createdAt])
  @@map("casino_credit_transactions")
}

model BalanceTransaction {
  id        Int      @id @default(autoincrement())
  balanceId Int      @map("balance_id")
  type      String   // topup | spend | refund | casino_win | casino_loss
  amount    Float
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  balance Balance @relation(fields: [balanceId], references: [id], onDelete: Cascade)

  @@map("balance_transactions")
}

model Discount {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  type        String   @default("percent") // percent | fixed
  value       Float
  minOrderAmount Float @default(0) @map("min_order_amount")
  usageLimit  Int?     @map("usage_limit")
  usedCount   Int      @default(0) @map("used_count")
  isActive    Boolean  @default(true) @map("is_active")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("discounts")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("reviews")
}

model Wishlist {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  productCityId Int      @map("product_city_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id])
  productCity ProductCity @relation(fields: [productCityId], references: [id])

  @@unique([userId, productCityId])
  @@map("wishlists")
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  status    String
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  subject   String
  message   String
  status    String   @default("open") // open | replied | closed
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User                   @relation(fields: [userId], references: [id])
  replies SupportTicketReply[]

  @@map("support_tickets")
}

model SupportTicketReply {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  isAdmin   Boolean  @default(false) @map("is_admin")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_ticket_replies")
}

model AdminSecurity {
  id           Int      @id @default(autoincrement())
  passwordHash String   @map("password_hash")
  passwordSalt String   @map("password_salt")
  passwordAlgo String   @default("scrypt") @map("password_algo")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_security")
}

model AdminSession {
  id             Int      @id @default(autoincrement())
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  revokedAt      DateTime? @map("revoked_at")

  @@index([expiresAt, revokedAt])
  @@map("admin_sessions")
}

model Operator {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique @map("telegram_id")
  firstName  String   @map("first_name")
  lastName   String?  @map("last_name")
  username   String?
  isActive   Boolean  @default(true) @map("is_active")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  assignedOrders Order[]

  @@map("operators")
}

model TelegramBot {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  botId      String   @unique @map("bot_id")
  username   String
  firstName  String   @map("first_name")
  isActive   Boolean  @default(true) @map("is_active")
  webAppUrl  String?  @map("web_app_url")
  menuText   String?  @map("menu_text")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("telegram_bots")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String?
  entityId  Int?     @map("entity_id")
  meta      String?  // JSON string
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model UserActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String
  meta      String?  // JSON string
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_activity_logs")
}

model DeliveryOption {
  id          Int      @id @default(autoincrement())
  name        String
  nameEn      String?  @map("name_en")
  type        String   @default("delivery") // delivery | pickup
  price       Float    @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("delivery_options")
}
