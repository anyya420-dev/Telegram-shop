{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run db:generate",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test",
    "prestart": "npm run db:generate",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost/dev} prisma generate --schema ./prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "db:push": "prisma db push --schema ./prisma/schema.prisma",
    "db:seed": "tsx ./prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "prisma": "^6.12.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
