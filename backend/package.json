{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate --schema ../database/prisma/schema.prisma",
    "db:push": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma db push --schema ../database/prisma/schema.prisma",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} tsx ../database/src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "prisma": "6.12.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
