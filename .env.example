# =============================================================================
# ENVIRONMENT VARIABLE CONTRACT
# =============================================================================
#
# FRONTEND (frontend Render service – Telegram-shop – Static Site)
# ---------------------------------------------------------------
# VITE_API_URL   – Full URL of the backend API, e.g.
#                  https://narcos-shop.onrender.com/api
#                  Must NOT target localhost in production.
#                  Baked in at build time by Vite.
#
# BACKEND (backend Render service – Narcos-shop – Node Web Service)
# ----------------------------------------------------------------
# NODE_ENV                – Set to "production" by Render automatically
# PORT                    – Set by Render automatically (read via process.env.PORT)
# DATABASE_URL            – PostgreSQL connection string (from Render DB)
# SESSION_SECRET          – Random secret for HMAC session tokens (required)
# OWNER_TELEGRAM_ID       – Numeric Telegram user ID of the shop owner;
#                           auto-granted admin access (required).
#                           Default: 8405501187
# ADMIN_PASSWORD          – Plaintext password compared server-side with
#                           scrypt; the source of truth for admin login (required)
# BOT_TOKEN_ENCRYPTION_KEY– 32+ char secret for AES-256-GCM encryption of
#                           the bot token stored in DB (required)
# TELEGRAM_BOT_TOKEN      – Telegram Bot API token; required for Telegram
#                           initData verification and polling; can also be
#                           configured via Admin Settings in the DB.
#                           The HTTP server starts even if this is absent —
#                           bot init runs in the background after HTTP startup.
# FRONTEND_URL            – Public URL of the frontend
#                           (e.g. https://78j.onrender.com)
#                           used for CORS allowlist (required)
# WEB_APP_URL             – Telegram Web App URL presented to bot users;
#                           defaults to FRONTEND_URL if omitted (required in prod)
# ALLOW_DEMO_MODE         – Must be "false" in production (required)
# ADMIN_TELEGRAM_IDS      – Optional comma-separated extra admin Telegram IDs
#
# DO NOT put real secrets in this file. Do NOT commit .env files.
# =============================================================================

# --- Frontend (set in Render dashboard for Telegram-shop static site) ---
VITE_API_URL=http://localhost:3001/api

# --- Backend (set in Render dashboard for Narcos-shop web service) ---
NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://localhost:5432/telegram_shop?schema=public"
FRONTEND_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173
ALLOW_DEMO_MODE=true
SESSION_SECRET=change_me_for_production
# Owner Telegram ID – this user is automatically granted admin access on first login
OWNER_TELEGRAM_ID=8405501187
# Comma-separated Telegram user IDs with admin access (empty = first registered user)
ADMIN_TELEGRAM_IDS=
# Required backend admin password (plain text env value, compared server-side with scrypt)
ADMIN_PASSWORD=change_me_admin_password

# Bot (optional when a bot token is already configured in DB via Admin Settings)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Bot token encryption key (32+ char secret; defaults to SESSION_SECRET if not set)
BOT_TOKEN_ENCRYPTION_KEY=change_me_for_production
