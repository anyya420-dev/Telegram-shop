# Frontend (frontend Render service only)
VITE_API_URL=http://localhost:3001/api

# Backend (backend Render service only)
NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://EXAMPLE_USER:EXAMPLE_PASSWORD@EXAMPLE_HOST:5432/telegram_shop?schema=public"
FRONTEND_URL=http://localhost:5173
WEB_APP_URL=http://localhost:5173
ALLOW_DEMO_MODE=true
SESSION_SECRET=change_me_for_production
# Owner Telegram ID – this user is automatically granted admin access on first login
OWNER_TELEGRAM_ID=8405501187
# Comma-separated Telegram user IDs with admin access (empty = first registered user)
ADMIN_TELEGRAM_IDS=
# Required backend admin password (plain text env value, compared server-side)
ADMIN_PASSWORD=change_me_admin_password

# Bot (optional only when a bot token is already configured in DB via Admin Settings)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Bot token encryption key (32+ char secret; defaults to SESSION_SECRET if not set)
BOT_TOKEN_ENCRYPTION_KEY=change_me_for_production
